
#To build GraphicsMagick along with the other support libraries:
#Note: IOCs shouldn't mix these libraries with system installed ones.
#WITH_GRAPHICSMAGICK=YES
WITH_GRAPHICSMAGICK=NO
GRAPHICSMAGICK_EXTERNAL=NO

WITH_TIFF=YES
TIFF_EXTERNAL=NO

WITH_ZLIB=YES
ZLIB_EXTERNAL=NO

XML2_EXTERNAL=NO

WITH_JPEG=YES
JPEG_EXTERNAL=NO

#WITH_BLOSC=YES
WITH_BLOSC=NO
BLOSC_EXTERNAL=NO

WITH_BITSHUFFLE=YES
BITSHUFFLE_EXTERNAL=NO

WITH_VC=YES
VC_EXTERNAL=NO


